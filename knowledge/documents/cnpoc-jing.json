  "sections": [
    {
      "section_id": "cnpoc-jing-zheng",
      "title": "正净与铜锤花脸",
      "locator": "正文（1）正净",
      "content": "正净又称大花脸、铜锤花脸，表演侧重唱功。国家京剧院课堂以《铡美案》的包拯说明这一类型。",
      "entity_names": [
        "正净",
        "大花脸",
        "铜锤花脸",
        "铡美案",
        "包拯"
      ]
    },
    {
      "section_id": "cnpoc-jing-fu",
      "title": "副净与架子花脸",
      "locator": "正文（2）副净",
      "content": "副净也叫二花脸、架子花脸，重念白和身段，同时要求武功与唱功。该课堂以《野猪林》的鲁智深作为例子。",
      "entity_names": [
        "副净",
        "二花脸",
        "架子花脸",
        "野猪林",
        "鲁智深"
      ]
    },
    {
      "section_id": "cnpoc-jing-wu",
      "title": "武净与摔打花脸",
      "locator": "正文（3）武净",
      "content": "武净又有武花脸、武二花、摔打花脸等称呼，侧重武打。该课堂以《艳阳楼》的高登为例，不能把这一人物例子推广为所有净角。",
      "entity_names": [
        "武净",
        "武花脸",
        "武二花",
        "摔打花脸",
        "艳阳楼",
        "高登"
      ]
    }
  ]
