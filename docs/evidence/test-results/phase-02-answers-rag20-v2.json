    {
      "id": "opera-q15",
      "question": "京剧里的蟒袍一般在什么身份和场合使用？黄蟒可表示什么？",
      "annotationStatus": "assistant_source_checked_candidate",
      "expectInsufficient": false,
      "idempotencyKey": "eval-eec82228858949858ea0db9e13ae4d59-15-df1265b32e6c",
      "attempts": 1,
      "status": "response_received",
      "startedAt": "2026-10-10T13:33:15.929152+08:00",
