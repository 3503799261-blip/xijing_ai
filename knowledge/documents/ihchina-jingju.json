    {
      "section_id": "ihchina-jingju-history",
      "title": "徽班进京与交流形成",
      "locator": "项目正文第一段",
      "content": "京剧形成于清代的剧种交流过程。三庆、四喜、春台、和春徽班进京后，与汉调艺人合作，并吸收昆曲、秦腔等艺术因素。徽班进京是发展节点，不能等同于一日完成剧种形成。",
      "entity_names": [
        "京剧",
        "三庆",
        "四喜",
        "春台",
        "和春",
        "汉调",
        "昆曲",
        "秦腔"
      ]
    },
    {
      "section_id": "ihchina-jingju-music",
      "title": "西皮与二簧",
      "locator": "项目正文第二段：唱腔",
      "content": "京剧主要使用西皮和二簧声腔。概括而言，二簧较舒缓凝重，西皮较明快起伏；这是声腔特点的基础介绍，具体情绪表达仍须结合唱段。",
      "entity_names": [
        "京剧",
        "西皮",
        "二簧"
      ]
    },
    {
      "section_id": "ihchina-jingju-accompaniment",
      "title": "文场与武场",
      "locator": "项目正文第二段：伴奏",
      "content": "京剧伴奏分文场、武场。文场以京胡等丝竹乐器为主，武场以鼓板以及大小锣等打击乐器为主；两类伴奏共同服务舞台表演。",
      "entity_names": [
        "京剧",
        "文场",
        "武场",
        "京胡",
        "鼓板",
        "小锣",
        "大锣"
      ]
    }
  ]
