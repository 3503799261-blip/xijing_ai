      ]
    },
    {
      "section_id": "cnpoc-face-three-tiles",
      "title": "三块瓦脸的结构",
      "locator": "京剧脸谱的分类—三块瓦脸",
      "content": "三块瓦脸在整脸基础上突出两块眉区与一块鼻窝，所以有三块瓦之称；其下还有正、尖、花、老等不同变式。",
      "entity_names": [
        "脸谱",
        "整脸",
        "三块瓦脸",
        "三块窝脸"
      ]
    },
    {
      "section_id": "cnpoc-face-symbolic",
      "title": "象形脸与神仙脸",
      "locator": "京剧脸谱的分类—象形脸、神仙脸",
      "content": "象形脸常见于神话戏，依据神怪形象组织图案，不拘统一谱式。神仙脸可借金银色或线条表现神圣感；这是舞台造型语言，不是人物历史相貌。",
      "entity_names": [
