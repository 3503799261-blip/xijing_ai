    {
      "id": "opera-q05",
      "question": "梅派由谁开创，属于什么行当的流派？",
      "annotationStatus": "assistant_source_checked_candidate",
      "expectInsufficient": false,
      "idempotencyKey": "eval-eec82228858949858ea0db9e13ae4d59-5-042e610813a3",
