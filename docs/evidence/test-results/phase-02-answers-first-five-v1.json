      "elapsedSeconds": 2.304847,
      "finishedAt": "2026-10-10T13:25:42.507068+08:00"
    },
    {
      "id": "opera-q02",
      "question": "京剧主要使用哪两种声腔？",
      "annotationStatus": "assistant_source_checked_candidate",
      "expectInsufficient": false,
      "idempotencyKey": "eval-d11835ca4fb445698be5b220b87e86c5-c0570c1eec1a4359",
      "attempts": 1,
      "status": "response_received",
      "startedAt": "2026-10-10T13:25:42.508069+08:00",
      "httpStatus": 200,
      "headerRequestId": "bb2d0747-b484-4a0d-bbea-560c28ebd2f7",
      "rawResponseSHA256": "8dff55aa562df1f5f97b3cd585fb99a7957252c5af9d41221cea3d7192a5c4c4",
      "response": {
        "answer": "京剧主要使用西皮和二簧两种声腔[chunk_b40ee72d545e8fc3fc08893ebebdfcde3da5babe4fe9cad964b83e118859418a]。概括来说，二簧较舒缓凝重，西皮较明快起伏；不过这只是声腔特点的基础介绍，具体情绪表达还要结合具体唱段来看[chunk_b40ee72d545e8fc3fc08893ebebdfcde3da5babe4fe9cad964b83e118859418a]。",
        "citations": [
          {
            "id": "chunk_b40ee72d545e8fc3fc08893ebebdfcde3da5babe4fe9cad964b83e118859418a",
            "title": "京剧",
            "sourceId": "ihchina-jingju",
            "locator": "项目正文第二段：唱腔 · 入库片段 1/1",
            "url": "https://www.ihchina.cn/project_details/13201",
            "excerpt": "京剧主要使用西皮和二簧声腔。\n概括而言，二簧较舒缓凝重，西皮较明快起伏；\n这是声腔特点的基础介绍，具体情绪表达仍须结合唱段。",
            "contentKind": "original_fact_summary"
          }
        ],
        "uncertain": false,
        "requestId": "bb2d0747-b484-4a0d-bbea-560c28ebd2f7"
