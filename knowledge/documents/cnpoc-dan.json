    {
      "section_id": "cnpoc-dan-qingyi-huadan",
      "title": "青衣与花旦",
      "locator": "正文（1）正旦、（2）花旦",
      "content": "青衣也称正旦，常表现举止稳重的中青年女性，重唱功。花旦常表现年轻、活泼的女性，更多侧重做功和说白；这属于入门概括。",
      "entity_names": [
        "旦",
        "青衣",
        "正旦",
        "花旦"
      ]
    },
    {
      "section_id": "cnpoc-dan-daoma-wu",
      "title": "刀马旦与武旦",
      "locator": "正文（3）刀马旦、（5）武旦",
      "content": "刀马旦常扮演女将帅，硬靠、雉尾是常见扮相，重唱念与舞蹈。武旦常着短装，表演更侧重武打与打出手等技巧。",
      "entity_names": [
        "刀马旦",
        "武旦",
        "硬靠",
        "雉尾",
        "打出手"
      ]
    },
    {
      "section_id": "cnpoc-dan-huashan-laodan",
      "title": "花衫与老旦",
      "locator": "正文（4）花衫、（6）老旦",
      "content": "花衫综合青衣、花旦、刀马旦的表演特点。老旦表现老年妇女，常重唱功并用本嗓，课堂举例为《杨门女将》的佘太君。",
      "entity_names": [
        "花衫",
        "老旦",
        "本嗓",
        "杨门女将",
        "佘太君"
      ]
    }
  ]
