    {
      "id": "opera-q03",
      "question": "京剧伴奏中的文场和武场分别以哪些乐器为主？",
      "annotationStatus": "assistant_source_checked_candidate",
      "expectInsufficient": false,
      "idempotencyKey": "eval-eec82228858949858ea0db9e13ae4d59-3-0b88c16bfb86",
      "attempts": 1,
      "status": "response_received",
      "startedAt": "2026-10-10T13:32:56.236986+08:00",
      "httpStatus": 200,
      "headerRequestId": "c23d4104-ebdb-4211-bbe1-8ff2932a4f8c",
      "rawResponseSHA256": "dee2de3de85bbaae515addc8bb21e88d162d90640abcc0fb15197346bc7eac5b",
      "response": {
        "answer": "京剧伴奏分为文场和武场两类。文场以京胡等丝竹乐器为主，武场以鼓板以及大小锣等打击乐器为主。两类伴奏共同服务于舞台表演。",
        "citations": [
          {
            "id": "chunk_c42e1bc513a6fb8cc2d03373a4cc724600cdd8be51ca07e02f2c54b29a5815a9",
            "title": "京剧",
            "sourceId": "ihchina-jingju",
            "locator": "项目正文第二段：伴奏 · 入库片段 1/1",
            "url": "https://www.ihchina.cn/project_details/13201",
            "excerpt": "京剧伴奏分文场、武场。\n文场以京胡等丝竹乐器为主，武场以鼓板以及大小锣等打击乐器为主；\n两类伴奏共同服务舞台表演。",
            "contentKind": "original_fact_summary"
          }
        ],
        "uncertain": false,
        "requestId": "c23d4104-ebdb-4211-bbe1-8ff2932a4f8c"
      },
      "responseSchemaValid": true,
      "redactionApplied": false,
      "requestId": "c23d4104-ebdb-4211-bbe1-8ff2932a4f8c",
      "elapsedSeconds": 1.174976,
